<mxfile host="app.diagrams.net"><diagram id="pipeline" name="How it works"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;How the diagram pipeline works&lt;/b&gt;&lt;br&gt;Every Monday 06:00 UTC (or the Run workflow button). Azure is only READ. Results are committed to the repository." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1200" height="50" as="geometry"/></mxCell><mxCell id="gh" value="GitHub · musaxasmammedov7/infrastructure" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F6F8FA;strokeColor=#24292F;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1070" height="620" as="geometry"/></mxCell><mxCell id="az" value="Azure · your tenant" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#0078D4;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="370" height="620" as="geometry"/></mxCell><mxCell id="trig" value="&lt;b&gt;Trigger&lt;/b&gt;&lt;br&gt;cron: Monday 06:00 UTC&lt;br&gt;or Actions → Run workflow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="20" y="40" width="220" height="70" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;GitHub Actions runner&lt;/b&gt;&lt;br&gt;temporary Ubuntu VM&lt;br&gt;reads .github/workflows/diagrams.yml" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="280" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="login" value="&lt;b&gt;0. Azure login (OIDC)&lt;/b&gt;&lt;br&gt;GitHub token → Azure token&lt;br&gt;no password stored anywhere" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="580" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b&gt;1. collect.py&lt;/b&gt;&lt;br&gt;5 read-only queries&lt;br&gt;to Resource Graph&lt;br&gt;secrets → hash" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="20" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b&gt;2. diff.py&lt;/b&gt;&lt;br&gt;new snapshot vs previous&lt;br&gt;added / changed / removed&lt;br&gt;+ who changed it" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="230" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b&gt;3. render.py&lt;/b&gt;&lt;br&gt;snapshot + diff → .drawio&lt;br&gt;(build/, not committed)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="440" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b&gt;4. draw.io export&lt;/b&gt;&lt;br&gt;.drawio → PNG" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="650" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b&gt;5. git commit + push&lt;/b&gt;&lt;br&gt;to branch main" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="gh"><mxGeometry x="860" y="190" width="190" height="90" as="geometry"/></mxCell><mxCell id="repo" value="What stays in the repository" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C8C8C;strokeWidth=2;fontSize=14;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;container=1;collapsible=0;" vertex="1" parent="gh"><mxGeometry x="20" y="370" width="1030" height="230" as="geometry"/></mxCell><mxCell id="snap" value="&lt;b&gt;snapshots/&lt;/b&gt;&lt;br&gt;one JSON per run:&lt;br&gt;all resources + settings&lt;br&gt;input for the NEXT diff&lt;br&gt;&lt;i&gt;not for reading&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="repo"><mxGeometry x="20" y="50" width="230" height="130" as="geometry"/></mxCell><mxCell id="chg" value="&lt;b&gt;changes/&lt;/b&gt;&lt;br&gt;one .md per run:&lt;br&gt;what changed since&lt;br&gt;the previous run&lt;br&gt;&lt;b&gt;read this&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="repo"><mxGeometry x="290" y="50" width="230" height="130" as="geometry"/></mxCell><mxCell id="dia" value="&lt;b&gt;diagrams/&lt;/b&gt;&lt;br&gt;PNG of the latest state&lt;br&gt;colours = changes&lt;br&gt;overwritten every run&lt;br&gt;&lt;b&gt;look at this&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="repo"><mxGeometry x="560" y="50" width="230" height="130" as="geometry"/></mxCell><mxCell id="hist" value="&lt;b&gt;git history&lt;/b&gt;&lt;br&gt;every older version&lt;br&gt;of all files" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="repo"><mxGeometry x="820" y="50" width="190" height="130" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;app gh-azure-diagrams&lt;br&gt;trusts only: repo musaxasmammedov7/&lt;br&gt;infrastructure, branch main" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="az"><mxGeometry x="20" y="40" width="330" height="90" as="geometry"/></mxCell><mxCell id="rbac" value="&lt;b&gt;Role: Reader&lt;/b&gt; on the subscription&lt;br&gt;can read everything, change nothing" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="az"><mxGeometry x="20" y="160" width="330" height="60" as="geometry"/></mxCell><mxCell id="arg" value="&lt;b&gt;Azure Resource Graph&lt;/b&gt;&lt;br&gt;resources · role assignments&lt;br&gt;DCR links · change history (14 days)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="az"><mxGeometry x="20" y="250" width="330" height="90" as="geometry"/></mxCell><mxCell id="subs" value="&lt;b&gt;Your subscription(s)&lt;/b&gt;&lt;br&gt;storage1musa, number1-network, …" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="az"><mxGeometry x="20" y="390" width="330" height="70" as="geometry"/></mxCell><mxCell id="note" value="Secrets in the repo: none.&lt;br&gt;Client / tenant / subscription IDs are&lt;br&gt;GitHub secrets; the login token lives&lt;br&gt;a few minutes inside the run." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;fontSize=11;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="az"><mxGeometry x="20" y="500" width="330" height="90" as="geometry"/></mxCell><mxCell id="e0" value="starts" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="trig" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="run" target="login"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="OIDC token ↔ access token" style="strokeColor=#B85450;strokeWidth=2;endArrow=block;endFill=1;startArrow=block;startFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5714;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.4444;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="login" target="entra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="entra" target="rbac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="then runs the steps" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="run" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="430" y="235"/><mxPoint x="135" y="235"/></Array></mxGeometry></mxCell><mxCell id="e5" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="read-only queries" style="strokeColor=#0078D4;strokeWidth=2;dashed=1;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8421;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="arg" target="s1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="375"/><mxPoint x="1100" y="250"/><mxPoint x="200" y="250"/></Array></mxGeometry></mxCell><mxCell id="e10" value="indexed" style="strokeColor=#0078D4;strokeWidth=2;dashed=1;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="subs" target="arg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="new file" style="strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.3158;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1739;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s1" target="snap"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="previous file" style="strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.9130;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1053;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="snap" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.7895;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.3043;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s2" target="chg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="" style="strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.2368;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s4" target="dia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="strokeColor=#9673A6;strokeWidth=2;endArrow=block;endFill=1;edgeStyle=none;html=1;rounded=0;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.6053;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="s5" target="hist"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
